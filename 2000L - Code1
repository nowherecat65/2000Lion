  style.id = "lionverse-motion-polish-style";
  style.type = "text/css";
  style.appendChild(document.createTextNode(css));
  document.head.appendChild(style);

  function closestMotionTarget(node) {
    if (!node || !node.closest) return null;
    return node.closest("button, input[type='button'], input[type='submit'], .person_button, #election_id_button, #candidate_id_button, #running_mate_id_button, #opponent_selection_id_button, #candidate_id_back, #running_mate_id_back, #opponent_selection_id_back, #latest_poll_button, #campaign_data_button, #answer_select_button, #ok_button, #no_feedback_button");
  }

  function markPressed(target) {
    if (!target || target.classList.contains("lion-button-pressing")) return;
    target.classList.add("lion-button-pressing");
    window.setTimeout(function() {
      if (target && target.classList) target.classList.remove("lion-button-pressing");
    }, 125);
  }

  function markAnswerLabel(node) {
    if (!node || !node.closest) return;
    var label = node.closest("#question_form label, .question_window label, .inner_window_question label");
    if (!label) return;
    if (!label.querySelector || !label.querySelector("input[type='radio'], input[type='checkbox']")) return;
    label.classList.add("lion-answer-touch");
    window.setTimeout(function() {
      if (label && label.classList) label.classList.remove("lion-answer-touch");
    }, 150);
  }

  function isMapOrVisitPanel(panel) {
    if (!panel || !panel.closest) return false;
    if (panel.closest("#map_container, #visit_window, #visit_content, #results_container, #state_result_container, #overall_result_container")) return true;
    var text = (panel.textContent || "").slice(0, 160).toLowerCase();
    return text.indexOf("select a state") !== -1 || text.indexOf("visits left") !== -1 || text.indexOf("estimated support") !== -1;
  }

  function findAdvisorPanel(root) {
    var direct = document.getElementById("feedback_window");
    if (direct && !isMapOrVisitPanel(direct)) return direct;
    if (!root || root.nodeType !== 1) return null;
    if (root.id === "feedback_window" && !isMapOrVisitPanel(root)) return root;
    if (root.querySelector) {
      var nested = root.querySelector("#feedback_window");
      if (nested && !isMapOrVisitPanel(nested)) return nested;
    }
    return null;
  }

  function markAdvisorChildren(panel) {
    if (!panel || !panel.querySelectorAll) return;
    var detailNodes = panel.querySelectorAll("p, ul, ol, li, blockquote, span, br");
    for (var i = 0; i < detailNodes.length; i++) {
      if (detailNodes[i].id === "ok_button" || detailNodes[i].id === "no_feedback_button") continue;
      if (detailNodes[i].classList) detailNodes[i].classList.add("lion-advisor-feedback-detail");
    }
    var actionNodes = panel.querySelectorAll("button, input[type='button'], input[type='submit'], #ok_button, #no_feedback_button");
    for (var j = 0; j < actionNodes.length; j++) {
      if (actionNodes[j].classList) actionNodes[j].classList.add("lion-advisor-feedback-action");
    }
  }

  function restartAnimation(panel) {
    panel.classList.remove("lion-advisor-feedback-window");
    panel.style.animation = "none";
    void panel.offsetWidth;
    panel.style.animation = "";
    panel.classList.add("lion-advisor-feedback-window");
  }

  function animateAdvisorPanel(panel) {
    if (!panel || !panel.classList || isMapOrVisitPanel(panel)) return;
    var overlay = document.getElementById("feedback_overlay");
    if (overlay && overlay.classList) {
      overlay.classList.remove("lion-advisor-feedback-scrim");
      overlay.style.animation = "none";
      void overlay.offsetWidth;
      overlay.style.animation = "";
      overlay.classList.add("lion-advisor-feedback-scrim");
    }
    markAdvisorChildren(panel);
    restartAnimation(panel);
  }

  function scanForAdvisorPanels(root) {
    var panel = findAdvisorPanel(root || document.body);
    if (panel) animateAdvisorPanel(panel);
  }

  function delayedAdvisorScan(root) {
    window.setTimeout(function() { scanForAdvisorPanels(root || document.body); }, 0);
    window.setTimeout(function() { scanForAdvisorPanels(document.body); }, 40);
  }

  document.addEventListener("mousedown", function(event) {
    markPressed(closestMotionTarget(event.target));
    markAnswerLabel(event.target);
    if (event.target && event.target.closest && event.target.closest("#answer_select_button")) delayedAdvisorScan(document.body);
  }, true);

  document.addEventListener("touchstart", function(event) {
    markPressed(closestMotionTarget(event.target));
    markAnswerLabel(event.target);
    if (event.target && event.target.closest && event.target.closest("#answer_select_button")) delayedAdvisorScan(document.body);
  }, { capture: true, passive: true });

  document.addEventListener("keydown", function(event) {
    if (event.key !== "Enter" && event.key !== " ") return;
    markPressed(closestMotionTarget(event.target));
    markAnswerLabel(event.target);
    if (event.target && event.target.closest && event.target.closest("#answer_select_button")) delayedAdvisorScan(document.body);
  }, true);

  if (window.MutationObserver) {
    var advisorObserver = new MutationObserver(function(mutations) {
      for (var i = 0; i < mutations.length; i++) {
        var added = mutations[i].addedNodes;
        for (var j = 0; j < added.length; j++) {
          if (added[j].nodeType === 1) delayedAdvisorScan(added[j]);
        }
      }
    });
    advisorObserver.observe(document.body || document.documentElement, { childList: true, subtree: true });
    window.__lionverseAdvisorObserver = advisorObserver;
  }

  window.setTimeout(function() { scanForAdvisorPanels(document.body); }, 60);
})();

 

